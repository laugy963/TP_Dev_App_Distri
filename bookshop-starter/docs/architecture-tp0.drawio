<mxfile host="app.diagrams.net">
  <diagram name="BookShop TP0" id="bookshop-tp0">
    <mxGraphModel dx="1240" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Titre -->
        <mxCell id="title" value="&lt;b&gt;BookShop — architecture au TP0&lt;/b&gt; (état de départ du projet fil rouge)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="35" as="geometry"/>
        </mxCell>

        <!-- Zones -->
        <mxCell id="zoneHost" value="Poste du développeur — JVM lancées par mvn spring-boot:run" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="600" height="640" as="geometry"/>
        </mxCell>
        <mxCell id="zoneDocker" value="Docker Compose « bookshop » — réseau bookshop_default" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#1f77b4;fontColor=#1f77b4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="660" y="60" width="560" height="640" as="geometry"/>
        </mxCell>

        <!-- Client -->
        <mxCell id="client" value="&lt;b&gt;Client HTTP&lt;/b&gt;&lt;br&gt;curl · http/starter.http" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="150" height="80" as="geometry"/>
        </mxCell>

        <!-- Microservices -->
        <mxCell id="catalog" value="&lt;b&gt;catalog-service&lt;/b&gt; — port 8081&lt;br&gt;Spring Boot 3.3 · Web · JPA · Actuator&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;GET/POST /api/books&lt;br&gt;GET/PUT/DELETE /api/books/{id}&lt;br&gt;GET /api/welcome&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="120" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="order" value="&lt;b&gt;order-service&lt;/b&gt; — port 8082&lt;br&gt;Spring Boot 3.3 · Web · JPA · RestClient&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;POST /api/orders&lt;br&gt;GET /api/orders · GET /api/orders/{id}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="500" width="250" height="110" as="geometry"/>
        </mxCell>

        <!-- PostgreSQL -->
        <mxCell id="pg" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt; — localhost:5432 (bookshop / bookshop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="680" y="100" width="320" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="catalogdb" value="&lt;b&gt;catalogdb&lt;/b&gt;&lt;br&gt;table book" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="700" y="140" width="135" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="catalogquerydb" value="catalogquerydb&lt;br&gt;&lt;i&gt;vide — TP9 (CQRS)&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#999999;fontColor=#777777;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="140" width="135" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="orderdb" value="&lt;b&gt;orderdb&lt;/b&gt;&lt;br&gt;table orders" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="700" y="260" width="135" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="paymentdb" value="paymentdb&lt;br&gt;&lt;i&gt;vide — TP10 (saga)&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#999999;fontColor=#777777;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="260" width="135" height="90" as="geometry"/>
        </mxCell>

        <!-- Kafka -->
        <mxCell id="kafka" value="&lt;b&gt;Kafka 3.7 (KRaft, sans ZooKeeper)&lt;/b&gt;&lt;br&gt;localhost:9092 (poste) · kafka:29092 (réseau Docker)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="680" y="400" width="320" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="topics" value="&lt;b&gt;Topics : aucun au TP0&lt;/b&gt;&lt;br&gt;&lt;i&gt;Prévus :&lt;/i&gt;&lt;br&gt;springCloudBus (TP2)&lt;br&gt;catalog.book-events (TP9)&lt;br&gt;saga.catalog.commands · saga.payment.commands&lt;br&gt;saga.replies (TP10)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontColor=#555555;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="460" width="280" height="130" as="geometry"/>
        </mxCell>

        <!-- Redis -->
        <mxCell id="redis" value="&lt;b&gt;Redis 7&lt;/b&gt; — localhost:6379&lt;br&gt;&lt;i&gt;inutilisé au TP0 (cache de session, TP4)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="630" width="320" height="55" as="geometry"/>
        </mxCell>

        <!-- Outils d'administration -->
        <mxCell id="adminer" value="&lt;b&gt;Adminer&lt;/b&gt;&lt;br&gt;localhost:8088" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1085" y="205" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="kafkaui" value="&lt;b&gt;Kafka UI&lt;/b&gt;&lt;br&gt;localhost:8089" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1085" y="475" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- Flux actifs -->
        <mxCell id="e-client-catalog" value="REST&lt;br&gt;/api/books · /api/welcome" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="client" target="catalog">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-client-order" value="REST&lt;br&gt;POST / GET /api/orders" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="client" target="order">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-order-catalog" value="&lt;b&gt;GET /api/books/{id}&lt;/b&gt;&lt;br&gt;HTTP synchrone (RestClient)&lt;br&gt;URL en dur : app.catalog.url&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;catalogue arrêté ⇒ 503&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="order" target="catalog">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-catalog-db" value="JDBC / JPA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="catalog" target="catalogdb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-order-db" value="JDBC / JPA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="order" target="orderdb">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="533"/>
              <mxPoint x="640" y="305"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-adminer-pg" value="postgres:5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=none;fontSize=10;" edge="1" parent="1" source="adminer" target="pg">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-12"/></mxGeometry>
        </mxCell>
        <mxCell id="e-kafkaui-kafka" value="kafka:29092" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=none;fontSize=10;" edge="1" parent="1" source="kafkaui" target="kafka">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-12"/></mxGeometry>
        </mxCell>

        <!-- Flux prévus -->
        <mxCell id="e-order-kafka" value="&lt;i&gt;prévu&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;startArrow=open;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.92;entryDx=0;entryDy=0;labelBackgroundColor=none;fontSize=10;" edge="1" parent="1" source="order" target="kafka">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-10"/></mxGeometry>
        </mxCell>

        <!-- Légende -->
        <mxCell id="legend" value="&lt;b&gt;Légende&lt;/b&gt; — trait plein : flux actif au TP0 · pointillés : élément ou flux prévu dans un TP ultérieur · flèche rouge : appel synchrone = couplage temporel (traité au TP6 puis TP10)&lt;br&gt;Pattern « une base par service » : chaque service n'accède qu'à sa propre base ; order-service obtient le prix via l'API du catalogue, jamais via catalogdb.&lt;br&gt;Les services tournent sur le poste et joignent l'infrastructure par les ports publiés par Docker (localhost:5432, :9092, :6379)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="715" width="1200" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
