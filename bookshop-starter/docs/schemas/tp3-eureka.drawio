        <mxCell id="v68" value="&lt;b&gt;201&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=none;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1193.7692307692307" y="428" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="v69" value="&lt;b&gt;201&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=none;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1265.3076923076924" y="428" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="l70" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90.0" y="325" as="sourcePoint"/><mxPoint x="90.0" y="480" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v71" value='&lt;b&gt;t = 0 : Ctrl+C sur 8091&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;désinscription : &lt;font face="Courier New"&gt;deregister status: 200&lt;/font&gt;&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30.0" y="512" width="260" height="40" as="geometry"/></mxCell>
        <mxCell id="l72" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#2d7d2d;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="888.8461538461538" y="325" as="sourcePoint"/><mxPoint x="888.8461538461538" y="480" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v73" value='&lt;b&gt;≈ t+33 s : cache rafraîchi&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;dernier 503 à t+32 s, plus aucune erreur dès t+35 s&lt;/font&gt;' style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="758.8461538461538" y="512" width="260" height="40" as="geometry"/></mxCell>
        <mxCell id="v74" value="&lt;b&gt;Pourquoi ce délai alors que l'annuaire est à jour immédiatement ?&lt;/b&gt;&lt;br&gt;La désinscription met à jour le &lt;b&gt;registre de l'annuaire&lt;/b&gt; tout de suite (tableau de bord : UP (1)).&lt;br&gt;Mais chaque client travaille sur sa &lt;b&gt;copie locale&lt;/b&gt;, téléchargée toutes les 30 s :&lt;br&gt;tant qu'il ne l'a pas rafraîchie, il continue d'envoyer des appels à l'instance arrêtée." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="640" height="100" as="geometry"/></mxCell>
        <mxCell id="v75" value="&lt;b&gt;À retenir pour la suite&lt;/b&gt;&lt;br&gt;• La découverte de services rend le système &lt;b&gt;élastique&lt;/b&gt;, pas &lt;b&gt;instantanément&lt;/b&gt; tolérant aux pannes.&lt;br&gt;• Arrêt brutal (kill -9) : pas de désinscription → l'annuaire attend l'expiration du bail (90 s).&lt;br&gt;• Le &lt;b&gt;retry&lt;/b&gt; (TP6) pourra masquer ces 503 : avec le round robin, le nouvel essai part vers l'autre instance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="700" y="580" width="660" height="100" as="geometry"/></mxCell>
        <mxCell id="v76" value="&lt;b&gt;Légende&lt;/b&gt; — pastilles vertes : 201 Created · rouges : 503 Service Unavailable (valeurs mesurées pendant le TP3, voir docs/tp3-rendu.md)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="715" width="1360" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
