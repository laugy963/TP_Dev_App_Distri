<mxfile host="app.diagrams.net">
  <diagram name="1. Architecture Eureka" id="p0">
    <mxGraphModel dx="1400" dy="780" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v1" value="&lt;b&gt;TP3 — Découverte de services avec Eureka&lt;/b&gt; : on appelle un &lt;b&gt;nom&lt;/b&gt;, l'annuaire fournit les adresses" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="35" as="geometry"/></mxCell>
        <mxCell id="v2" value="&lt;b&gt;discovery-server&lt;/b&gt; :8761 — &lt;font face=&quot;Courier New&quot;&gt;@EnableEurekaServer&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;tableau de bord : http://localhost:8761&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Registre&lt;/b&gt; (en mémoire)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;CATALOG-SERVICE&amp;nbsp;&amp;nbsp;UP (2)&lt;/font&gt;  → …:8081 · …:8091&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;ORDER-SERVICE&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;UP (1)&lt;/font&gt;  → …:8082&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;i&gt;register-with-eureka: false — l'annuaire ne s'inscrit pas lui-même&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="60" width="400" height="175" as="geometry"/></mxCell>
        <mxCell id="v3" value='&lt;b&gt;catalog-service&lt;/b&gt; — instance 1&lt;br&gt;&lt;font style="font-size:11px"&gt;:8081 · nom : catalog-service&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="320" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="v4" value='&lt;b&gt;catalog-service&lt;/b&gt; — instance 2&lt;br&gt;&lt;font style="font-size:11px"&gt;:8091 · même nom&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="460" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="e5" value="&lt;b&gt;① s'inscrit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;register → 204&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;puis heartbeat / 30 s&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0e8088;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#0e8088;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3" target="v2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="&lt;b&gt;① s'inscrit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;heartbeat / 30 s&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0e8088;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#0e8088;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v4" target="v2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="500"/></Array></mxGeometry></mxCell>
        <mxCell id="v7" value='&lt;b&gt;order-service&lt;/b&gt; :8082&lt;br&gt;&lt;font style="font-size:11px"&gt;inscrit aussi (ORDER-SERVICE)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;arcSize=4;" vertex="1" parent="1"><mxGeometry x="360" y="330" width="340" height="210" as="geometry"/></mxCell>
        <mxCell id="v8" value='&lt;font style="font-size:11px"&gt;&lt;b&gt;CatalogClient&lt;/b&gt; → &lt;font face="Courier New"&gt;http://catalog-service&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="385" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="v9" value='&lt;font style="font-size:11px"&gt;&lt;b&gt;RestClient.Builder @LoadBalanced&lt;/b&gt; (Spring Cloud LoadBalancer)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="435" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="v10" value='&lt;font style="font-size:11px"&gt;&lt;b&gt;cache local du registre&lt;/b&gt; : catalog-service → [8081, 8091]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="380" y="485" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e13" value='&lt;b&gt;② télécharge le registre&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;au démarrage puis toutes les 30 s&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0e8088;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#0e8088;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v7" target="v2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="147"/></Array></mxGeometry></mxCell>
        <mxCell id="e14" value='&lt;b&gt;③ GET /api/books/{id}&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;appels 1, 3, 5&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v7" target="v3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e15" value='&lt;b&gt;③ GET /api/books/{id}&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;appels 2, 4, 6&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v7" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v16" value='&lt;b&gt;Client HTTP&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;curl : 6 commandes&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="395" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="e17" value="&lt;b&gt;POST /api/orders&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v16" target="v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v18" value="&lt;b&gt;order-service/application.yml&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Avant (TP0 à TP2)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;app.catalog.url: &lt;font color=&quot;#b85450&quot;&gt;http://localhost:8081&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;i&gt;une machine précise, une seule instance&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Après (TP3)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;app.catalog.url: &lt;font color=&quot;#2d7d2d&quot;&gt;http://catalog-service&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;i&gt;un nom logique, traduit par l'annuaire&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;eureka.client.service-url.defaultZone:&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;http://localhost:8761/eureka&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#ffffff;strokeColor=#0e8088;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="300" height="200" as="geometry"/></mxCell>
        <mxCell id="v19" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;@LoadBalanced&lt;/font&gt; — ce qui change&lt;/b&gt;&lt;br&gt;L'hôte de &lt;font face=&quot;Courier New&quot;&gt;http://catalog-service&lt;/font&gt; n'est &lt;b&gt;pas résolu par le DNS&lt;/b&gt; :&lt;br&gt;c'est la clé sous laquelle les instances se sont inscrites&lt;br&gt;(leur &lt;font face=&quot;Courier New&quot;&gt;spring.application.name&lt;/font&gt;).&lt;br&gt;Avant chaque appel, l'intercepteur remplace ce nom par l'adresse&lt;br&gt;d'une instance, choisie &lt;b&gt;à tour de rôle (round robin)&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="440" height="125" as="geometry"/></mxCell>
        <mxCell id="v20" value="&lt;b&gt;Ce que l'on gagne&lt;/b&gt;&lt;br&gt;• ajouter une instance = la lancer : elle s'inscrit, les clients la voient&lt;br&gt;• une instance arrêtée disparaît de l'annuaire (désinscription ou&lt;br&gt;  expiration du bail après 90 s sans heartbeat)&lt;br&gt;• aucun port, aucune machine écrits en dur côté appelant&lt;br&gt;• mesuré : 6 commandes → 3 requêtes SQL sur 8081, 3 sur 8091" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="480" y="580" width="440" height="125" as="geometry"/></mxCell>
        <mxCell id="v21" value="&lt;b&gt;Réglages « confort de TP » de l'annuaire&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;enable-self-preservation: false&lt;/font&gt; et &lt;font face=&quot;Courier New&quot;&gt;eviction-interval-timer-in-ms: 5000&lt;/font&gt;&lt;br&gt;→ les instances mortes disparaissent vite.&lt;br&gt;En production, on garde la self-preservation : l'annuaire ne purge pas&lt;br&gt;tout son registre lors d'une coupure réseau passagère.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;i&gt;Équivalents cloud : DNS de Kubernetes (TP11), AWS Cloud Map.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="940" y="580" width="440" height="125" as="geometry"/></mxCell>
        <mxCell id="v22" value="&lt;b&gt;Légende&lt;/b&gt; — turquoise : échanges avec l'annuaire (inscription, heartbeat, téléchargement du registre) · bleu : appels métier vers le catalogue · ① ② ③ : ordre des échanges." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="1360" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. Round robin et perte d'instance" id="p1">
    <mxGraphModel dx="1400" dy="770" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="770" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v1" value="&lt;b&gt;TP3 — Ce que fait @LoadBalanced à chaque appel&lt;/b&gt;, et ce qui se passe quand une instance tombe" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="35" as="geometry"/></mxCell>
        <mxCell id="v2" value='&lt;b&gt;CatalogClient&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;&lt;font face="Courier New"&gt;GET http://catalog-service&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;&lt;font face="Courier New"&gt;/api/books/1&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="v3" value="&lt;b&gt;1&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="12" y="62" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v4" value="&lt;b&gt;Intercepteur LoadBalancer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;« catalog-service » n'est pas un nom DNS : c'est un service&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="296" y="70" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="v5" value="&lt;b&gt;2&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="288" y="62" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="v2" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v7" value='&lt;b&gt;Cache local du registre&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;rafraîchi toutes les 30 s&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;[…:8081, …:8091]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=12;" vertex="1" parent="1"><mxGeometry x="572" y="70" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="v8" value="&lt;b&gt;3&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="564" y="62" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="v4" target="v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v10" value='&lt;b&gt;Round robin&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;appel 1 → 8081, appel 2 → 8091,&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;appel 3 → 8081…&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="848" y="70" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="v11" value="&lt;b&gt;4&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="840" y="62" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="v7" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v13" value='&lt;b&gt;URL réécrite&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;&lt;font face="Courier New"&gt;http://10.167.129.219:8081&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;&lt;font face="Courier New"&gt;/api/books/1&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1124" y="70" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="v14" value="&lt;b&gt;5&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1116" y="62" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="v10" target="v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v16" value="&lt;b&gt;Mesuré au TP3 : six commandes passées via order-service&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="600" height="22" as="geometry"/></mxCell>
        <mxCell id="v17" value='&lt;b&gt;commande 1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;201 · SQL sur 8081&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="v18" value='&lt;b&gt;commande 2&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;201 · SQL sur 8091&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fillColor=#c9dcf5;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="140" y="210" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="v19" value='&lt;b&gt;commande 3&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;201 · SQL sur 8081&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="210" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="v20" value='&lt;b&gt;commande 4&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;201 · SQL sur 8091&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fillColor=#c9dcf5;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="210" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="v21" value='&lt;b&gt;commande 5&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;201 · SQL sur 8081&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="210" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="v22" value='&lt;b&gt;commande 6&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;201 · SQL sur 8091&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fillColor=#c9dcf5;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="620" y="210" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="v23" value="Chaque commande déclenche &lt;font face=&quot;Courier New&quot;&gt;select … from book where id=?&lt;/font&gt; sur l'instance choisie :&lt;br&gt;&lt;b&gt;3 requêtes dans la console 8081, 3 dans la console 8091&lt;/b&gt;, en alternance.&lt;br&gt;order-service n'a jamais connu ces ports : c'est l'annuaire qui les lui a donnés." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="205" width="620" height="60" as="geometry"/></mxCell>
        <mxCell id="v24" value="Perte d'une instance : 8091 arrêtée proprement (Ctrl+C) à 09:40:46, une commande toutes les 3 s" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fdf8f8;strokeColor=#b85450;fontColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="1360" height="410" as="geometry"/></mxCell>
        <mxCell id="v25" value="" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=none;opacity=60;" vertex="1" parent="1"><mxGeometry x="90.0" y="335" width="798.8461538461538" height="55" as="geometry"/></mxCell>
        <mxCell id="v26" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=none;opacity=60;" vertex="1" parent="1"><mxGeometry x="888.8461538461538" y="335" width="441.1538461538462" height="55" as="geometry"/></mxCell>
        <mxCell id="v27" value="&lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;Liste périmée&lt;/font&gt;&lt;/b&gt; : order-service garde dans son cache l'ancienne liste [8081, 8091].&lt;br&gt;Un appel sur deux part vers 8091, qui ne répond plus → &lt;b&gt;503&lt;/b&gt;." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="98.0" y="340" width="782.8461538461538" height="50" as="geometry"/></mxCell>
        <mxCell id="v28" value='&lt;b&gt;&lt;font color="#2d7d2d"&gt;Liste rafraîchie&lt;/font&gt;&lt;/b&gt; : [8081] seulement.&lt;br&gt;Toutes les commandes aboutissent.' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="896.8461538461538" y="340" width="425.1538461538462" height="50" as="geometry"/></mxCell>
