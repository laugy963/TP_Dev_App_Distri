        <mxCell id="v13" value='&lt;b&gt;application.yml interne (dans le jar)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;font face="Courier New"&gt;"Bienvenue (fichier interne)"&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=48;" vertex="1" parent="1"><mxGeometry x="60" y="388" width="580" height="52" as="geometry"/></mxCell>
