        <mxCell id="l17" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=3;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="36" y="500" as="sourcePoint"/><mxPoint x="36" y="92" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v18" value="&lt;b&gt;plus prioritaire&lt;/b&gt;" style="text;html=1;horizontal=0;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="4" y="230" width="30" height="160" as="geometry"/></mxCell>
        <mxCell id="v19" value="&lt;b&gt;La règle&lt;/b&gt; : quand deux sources définissent la même clé, la plus forte &lt;b&gt;masque&lt;/b&gt; l'autre.&lt;br&gt;Les sources plus faibles ne disparaissent pas : elles servent pour les clés que la source forte&lt;br&gt;ne définit pas (ex. le port vient du fichier interne même quand le message vient de l'argument)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="580" height="72" as="geometry"/></mxCell>
        <mxCell id="v20" value='&lt;b&gt;Les 5 scénarios du TP : la source gagnante&lt;/b&gt; (&lt;font color="#2d7d2d"&gt;★ vert&lt;/font&gt;, sources masquées barrées)' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="58" width="700" height="22" as="geometry"/></mxCell>
