        <mxCell id="v62" value='&lt;font style="font-size:10px"&gt;Bienvenue (valeur par défaut du code)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1274" y="388" width="106" height="70" as="geometry"/></mxCell>
        <mxCell id="v63" value="&lt;font style=&quot;font-size:11px&quot;&gt;&lt;i&gt;Le rang 2 (SPRING_APPLICATION_JSON) se place entre les arguments et les variables d'environnement ; le rang 4 (config server) n'existe qu'à partir du TP2 : grâce à &lt;font face=&quot;Courier New&quot;&gt;optional:&lt;/font&gt;, il est ignoré s'il est absent.&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="464" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="v64" value="&lt;b&gt;Relaxed binding&lt;/b&gt; : propriété → variable d'environnement&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;app.welcome-message&lt;/font&gt;  →  &lt;font face=&quot;Courier New&quot;&gt;APP_WELCOME_MESSAGE&lt;/font&gt;&lt;br&gt;majuscules, points et tirets remplacés par des soulignés.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;Piège&lt;/b&gt; : une variable oubliée dans le terminal fausse tous les&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;scénarios suivants → &lt;font face=&quot;Courier New&quot;&gt;env | grep APP_&lt;/font&gt; puis &lt;font face=&quot;Courier New&quot;&gt;unset APP_WELCOME_MESSAGE&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="440" height="118" as="geometry"/></mxCell>
        <mxCell id="v65" value="&lt;b&gt;Savoir d'où vient une valeur&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;GET /actuator/env/app.welcome-message&lt;/font&gt;&lt;br&gt;→ la valeur retenue &lt;b&gt;et&lt;/b&gt; toutes les sources candidates, dans l'ordre.&lt;br&gt;&lt;br&gt;Endpoints exposés au TP1 : health, info, env, conditions, refresh." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="480" y="640" width="440" height="118" as="geometry"/></mxCell>
        <mxCell id="v66" value="&lt;b&gt;Pourquoi c'est important (facteur III)&lt;/b&gt;&lt;br&gt;Le &lt;b&gt;même jar&lt;/b&gt; part en dev, en recette et en prod :&lt;br&gt;seule la configuration change, et elle est injectée de l'extérieur&lt;br&gt;(arguments, variables, puis config server au TP2,&lt;br&gt;ConfigMap/Secret Kubernetes au TP11). On ne recompile jamais pour&lt;br&gt;changer un paramètre." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="940" y="640" width="440" height="118" as="geometry"/></mxCell>
        <mxCell id="v67" value="&lt;b&gt;Légende&lt;/b&gt; — bleu : sources externes au jar · vert : fichiers dans le jar · gris : code · orange pointillé : source ajoutée au TP2 · ★ : valeur effectivement renvoyée." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="772" width="1360" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. Profils et feature flag" id="p1">
    <mxGraphModel dx="1400" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v1" value="&lt;b&gt;TP1 — Profils dev/prod et beans conditionnels&lt;/b&gt; : un seul code, des comportements choisis par la configuration" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="35" as="geometry"/></mxCell>
        <mxCell id="v2" value="Profils : un fichier commun + un fichier par environnement" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="660" height="720" as="geometry"/></mxCell>
        <mxCell id="v3" value='&lt;b&gt;application.yml&lt;/b&gt;  &lt;font style="font-size:11px"&gt;&lt;i&gt;(toujours chargé)&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;server.port: 8081&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;spring.datasource.url: …/catalogdb&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;app.welcome-message: "Bienvenue (fichier interne)"&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;app.features.discount-enabled: false&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#f3f9f1;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="150" y="100" width="400" height="105" as="geometry"/></mxCell>
        <mxCell id="v4" value='&lt;b&gt;application-dev.yml&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;spring.jpa.show-sql: true&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;logging.level.fr.cesi.bookshop: DEBUG&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#f2f6fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="290" height="75" as="geometry"/></mxCell>
        <mxCell id="v5" value='&lt;b&gt;application-prod.yml&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;app.welcome-message: "Bienvenue (profil prod)"&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;logging.level.root: WARN&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fdf3f3;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="370" y="290" width="290" height="75" as="geometry"/></mxCell>
        <mxCell id="v6" value='&lt;font face="Courier New"&gt;java -jar … --spring.profiles.active=dev&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Configuration effective&lt;/b&gt;&lt;br&gt;application.yml &lt;b&gt;+&lt;/b&gt; application-dev.yml&lt;br&gt;• requêtes SQL affichées, logs DEBUG&lt;br&gt;• message : « fichier interne »&lt;br&gt;• &lt;b&gt;DataLoader actif&lt;/b&gt; (données de test)' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="v7" value='&lt;font face="Courier New"&gt;java -jar … --spring.profiles.active=prod&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Configuration effective&lt;/b&gt;&lt;br&gt;application.yml &lt;b&gt;+&lt;/b&gt; application-prod.yml&lt;br&gt;• logs WARN seulement&lt;br&gt;• message : « profil prod » (masque le fichier commun)&lt;br&gt;• pas de DataLoader' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="470" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3" target="v6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="440"/><mxPoint x="257" y="440"/></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3" target="v7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="440"/><mxPoint x="442" y="440"/></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="profil dev" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v4" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e11" value="profil prod" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v12" value="&lt;b&gt;Ce qu'il faut retenir&lt;/b&gt;&lt;br&gt;• Le fichier de profil &lt;b&gt;s'ajoute&lt;/b&gt; au fichier commun : il ne contient que les différences.&lt;br&gt;• Pour une même clé, le fichier de profil (rang 5) l'emporte sur le fichier commun (rang 6).&lt;br&gt;• Le profil se choisit au lancement (&lt;font face=&quot;Courier New&quot;&gt;--spring.profiles.active&lt;/font&gt; ou &lt;font face=&quot;Courier New&quot;&gt;SPRING_PROFILES_ACTIVE&lt;/font&gt;) :&lt;br&gt;  le jar est identique en dev et en prod." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="620" height="130" as="geometry"/></mxCell>
        <mxCell id="v13" value="Beans conditionnels : activer du code sans le modifier" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#1f77b4;fontColor=#1f77b4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="680" height="720" as="geometry"/></mxCell>
        <mxCell id="v14" value='&lt;b&gt;1. Bean lié à un profil : &lt;/b&gt;&lt;font face="Courier New"&gt;@Profile("dev")&lt;/font&gt; sur DataLoader' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="92" width="640" height="22" as="geometry"/></mxCell>
        <mxCell id="v15" value="profil &lt;b&gt;dev&lt;/b&gt; actif ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="125" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="v16" value='&lt;b&gt;bean DataLoader créé&lt;/b&gt; (CommandLineRunner)&lt;br&gt;si la table book est vide : insère 5 livres&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;font face="Courier New"&gt;DataLoader : 5 livres insérés&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="225" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="v17" value="&lt;b&gt;aucun bean&lt;/b&gt;&lt;br&gt;aucune donnée de test&lt;br&gt;ne peut atterrir en production" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="225" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="e18" value="&lt;b&gt;oui&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#fafafa;fontColor=#2d7d2d;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v15" target="v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e19" value="&lt;b&gt;non (prod)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#fafafa;fontColor=#b85450;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v15" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="l20" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#cccccc;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="340" as="sourcePoint"/><mxPoint x="1360" y="340" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v21" value='&lt;b&gt;2. Feature flag sur DiscountService&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;&lt;font face="Courier New"&gt;@ConditionalOnProperty(name = "app.features.discount-enabled", havingValue = "true")&lt;/font&gt;&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="352" width="640" height="40" as="geometry"/></mxCell>
        <mxCell id="v22" value='&lt;font face="Courier New"&gt;app.features.discount-enabled&lt;/font&gt;&lt;br&gt;vaut &lt;b&gt;true&lt;/b&gt; ?' style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="400" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="v23" value='&lt;b&gt;bean DiscountService créé&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;font face="Courier New"&gt;Feature flag discount-enabled ACTIF&lt;/font&gt;&lt;/font&gt;&lt;br&gt;prix × 0,90 (remise de 10 %)&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;font face="Courier New"&gt;--app.features.discount-enabled=true&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="515" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="v24" value='&lt;b&gt;pas de bean&lt;/b&gt; (valeur par défaut : false)&lt;br&gt;les appelants injectent&lt;br&gt;&lt;font face="Courier New"&gt;ObjectProvider&amp;lt;DiscountService&amp;gt;&lt;/font&gt;&lt;br&gt;→ ils fonctionnent sans lui : prix normal' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="515" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="e25" value="&lt;b&gt;oui&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#fafafa;fontColor=#2d7d2d;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v22" target="v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e26" value="&lt;b&gt;non&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#fafafa;fontColor=#b85450;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v22" target="v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v27" value="&lt;b&gt;Vérifier qu'un bean a été créé ou non&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;GET /actuator/conditions&lt;/font&gt; → &lt;font face=&quot;Courier New&quot;&gt;positiveMatches&lt;/font&gt; / &lt;font face=&quot;Courier New&quot;&gt;negativeMatches&lt;/font&gt;&lt;br&gt;DiscountService apparaît dans les correspondances positives quand le flag est à true.&lt;br&gt;&lt;br&gt;&lt;b&gt;Intérêt du feature flag&lt;/b&gt; : livrer le code désactivé, puis l'allumer (ou l'éteindre en urgence)&lt;br&gt;par la configuration, sans recompiler. La condition est évaluée &lt;b&gt;au démarrage&lt;/b&gt; : basculer le flag demande un redémarrage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="720" y="640" width="640" height="125" as="geometry"/></mxCell>
        <mxCell id="v28" value="&lt;b&gt;Légende&lt;/b&gt; — fichiers à coin replié : fichiers YAML du jar · losanges : condition évaluée au démarrage par Spring · bleu : profil dev · rouge : profil prod · orange : feature flag." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="1360" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
