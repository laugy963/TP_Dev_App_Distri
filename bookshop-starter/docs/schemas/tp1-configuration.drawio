        <mxCell id="v15" value='&lt;b&gt;Valeur par défaut dans le code&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;font face="Courier New"&gt;@Value("${app.welcome-message:…}")&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=48;" vertex="1" parent="1"><mxGeometry x="60" y="448" width="580" height="52" as="geometry"/></mxCell>
