        <mxCell id="v45" value="Démarrage en ~3 s, mais ni arrêt gracieux ni timeout sur l'appel au catalogue." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="364" width="310" height="70" as="geometry"/></mxCell>
