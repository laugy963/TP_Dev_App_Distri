        <mxCell id="v60" value="init.sql, script shell pour les topics, ddl-auto : rien n'est versionné." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1059" y="364" width="310" height="70" as="geometry"/></mxCell>
