        <mxCell id="v50" value="Mêmes services via Docker, Testcontainers ; schéma par Hibernate, images non figées." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="373" y="364" width="310" height="70" as="geometry"/></mxCell>
