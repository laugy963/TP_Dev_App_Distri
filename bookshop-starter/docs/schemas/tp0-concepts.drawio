        <mxCell id="v30" value="Services sans état : tout est en base, pas de session HTTP en mémoire." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="373" y="232" width="310" height="70" as="geometry"/></mxCell>
