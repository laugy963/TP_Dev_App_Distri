        <mxCell id="v35" value="Tomcat embarqué, port 8081/8082 surchargeable par SERVER_PORT." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="716" y="232" width="310" height="70" as="geometry"/></mxCell>
