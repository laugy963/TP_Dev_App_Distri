        <mxCell id="v40" value="Duplicable en théorie, mais order-service ne connaît qu'un catalogue." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1059" y="232" width="310" height="70" as="geometry"/></mxCell>
