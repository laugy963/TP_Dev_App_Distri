        <mxCell id="v38" value="&lt;b&gt;VIII · Concurrency&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;arcSize=10;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1049" y="192" width="330" height="32" as="geometry"/></mxCell>
