<mxfile host="app.diagrams.net">
  <diagram name="1. Multi-module et base par service" id="p0">
    <mxGraphModel dx="1400" dy="790" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="790" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v1" value="&lt;b&gt;TP0 — Projet multi-module et pattern « une base par service »&lt;/b&gt; (les deux idées qui structurent BookShop)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="35" as="geometry"/></mxCell>
        <mxCell id="v2" value="Projet Maven multi-module — un dépôt, plusieurs services déployables" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="640" height="580" as="geometry"/></mxCell>
        <mxCell id="v3" value='&lt;b&gt;bookshop-parent&lt;/b&gt; — pom.xml racine (packaging pom)&lt;br&gt;&lt;font style="font-size:11px"&gt;parent : spring-boot-starter-parent 3.3.5 · Java 21&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;BOM spring-cloud-dependencies 2023.0.3 · springdoc 2.6.0&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;font face="Courier New"&gt;&amp;lt;modules&amp;gt;&lt;/font&gt; : liste des services à construire&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="105" width="380" height="120" as="geometry"/></mxCell>
        <mxCell id="v4" value='&lt;b&gt;catalog-service&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;fr.cesi.bookshop · pom.xml&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;→ catalog-service.jar&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="v5" value='&lt;b&gt;order-service&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;fr.cesi.bookshop · pom.xml&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;→ order-service.jar&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="e6" value="hérite des versions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7" value="hérite des versions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3" target="v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v8" value='&lt;font face="Courier New"&gt;mvn -DskipTests package&lt;/font&gt; construit tous les modules (« Reactor Summary ») ;&lt;br&gt;chaque module produit &lt;b&gt;son propre jar exécutable&lt;/b&gt; (Tomcat embarqué) :&lt;br&gt;on peut le livrer, le redémarrer et le multiplier &lt;b&gt;sans toucher aux autres&lt;/b&gt;.' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="600" height="60" as="geometry"/></mxCell>
        <mxCell id="v9" value="&lt;b&gt;Modules ajoutés au fil des TP&lt;/b&gt; (même parent, mêmes versions) :" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="475" width="600" height="20" as="geometry"/></mxCell>
        <mxCell id="v10" value='&lt;b&gt;config-server&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;TP2&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="505" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="v11" value='&lt;b&gt;discovery-server&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;TP3&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="192" y="505" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="v12" value='&lt;b&gt;gateway&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;TP4&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="344" y="505" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="v13" value='&lt;b&gt;bff-web&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;TP4&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="496" y="505" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="v14" value="&lt;b&gt;Pourquoi un parent commun ?&lt;/b&gt; Les versions de Spring Boot et Spring Cloud sont fixées une seule fois :&lt;br&gt;tous les services parlent la même version des bibliothèques. Un module = un service = un déploiement." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="572" width="600" height="50" as="geometry"/></mxCell>
        <mxCell id="v15" value="Pattern « une base par service » — chaque service est seul maître de ses données" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#1f77b4;fontColor=#1f77b4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="680" height="580" as="geometry"/></mxCell>
        <mxCell id="v16" value='&lt;b&gt;catalog-service&lt;/b&gt; :8081&lt;br&gt;&lt;font style="font-size:11px"&gt;possède les livres&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="120" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="v17" value='&lt;b&gt;order-service&lt;/b&gt; :8082&lt;br&gt;&lt;font style="font-size:11px"&gt;possède les commandes&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="120" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="v18" value="&lt;b&gt;catalogdb&lt;/b&gt;&lt;br&gt;table book" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="300" width="140" height="90" as="geometry"/></mxCell>
        <mxCell id="v19" value="&lt;b&gt;orderdb&lt;/b&gt;&lt;br&gt;table orders" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1190" y="300" width="140" height="90" as="geometry"/></mxCell>
        <mxCell id="e20" value="JDBC / JPA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;labelBackgroundColor=#fafafa;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v16" target="v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e21" value="JDBC / JPA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;labelBackgroundColor=#fafafa;endArrow=block;endFill=1;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v17" target="v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e22" value="&lt;b&gt;GET /api/books/{id}&lt;/b&gt;&lt;br&gt;seul accès autorisé :&lt;br&gt;par l'API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#fafafa;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v17" target="v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e23" value='&lt;font color="#b85450"&gt;&lt;b&gt;✗ interdit&lt;/b&gt;&lt;br&gt;lire catalogdb directement&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;labelBackgroundColor=#fafafa;endArrow=block;endFill=1;dashed=1;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v17" target="v18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1170" y="345"/></Array></mxGeometry></mxCell>
        <mxCell id="v24" value="PostgreSQL 16 — un seul serveur, &lt;b&gt;une base par service&lt;/b&gt; (catalogdb, orderdb, puis catalogquerydb, paymentdb)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#8a6d00;" vertex="1" parent="1"><mxGeometry x="720" y="410" width="640" height="30" as="geometry"/></mxCell>
        <mxCell id="v25" value="&lt;b&gt;&lt;font color=&quot;#2d7d2d&quot;&gt;Ce que l'on gagne&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• chaque équipe fait évoluer son schéma sans casser les autres&lt;br&gt;• chaque service se déploie et se dimensionne seul&lt;br&gt;• une panne de base ne touche qu'un service&lt;br&gt;• chaque service peut choisir sa technologie de stockage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="720" y="455" width="310" height="125" as="geometry"/></mxCell>
        <mxCell id="v26" value="&lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;Ce que l'on paie&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• plus de jointure SQL entre livres et commandes&lt;br&gt;• il faut passer par une API (REST) ou des événements (Kafka)&lt;br&gt;• la cohérence entre bases n'est plus une transaction : elle se gère (saga, TP10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1050" y="455" width="310" height="125" as="geometry"/></mxCell>
        <mxCell id="v27" value="&lt;b&gt;Docker Compose&lt;/b&gt; décrit toute l'infrastructure de support : PostgreSQL 16 · Kafka 3.7 (KRaft) · Redis 7 · Kafka UI · Adminer&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;docker compose up -d&lt;/font&gt; → le même environnement, reproductible sur chaque poste (dev/prod parity)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="1360" height="60" as="geometry"/></mxCell>
        <mxCell id="v28" value="&lt;b&gt;Légende&lt;/b&gt; — trait plein : flux autorisé · rouge pointillé : flux interdit par le pattern · cadres pointillés : modules ajoutés dans les TP suivants." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="735" width="1360" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. Chemin d'une commande" id="p1">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v1" value="&lt;b&gt;TP0 — Le chemin d'une commande&lt;/b&gt; : POST /api/orders, un appel synchrone au catalogue" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="35" as="geometry"/></mxCell>
        <mxCell id="v2" value='&lt;b&gt;Client HTTP&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;curl · starter.http&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="l3" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#999999;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="110" as="sourcePoint"/><mxPoint x="110" y="600" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v4" value='&lt;b&gt;order-service&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;:8082&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="l5" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#999999;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="110" as="sourcePoint"/><mxPoint x="420" y="600" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v6" value='&lt;b&gt;catalog-service&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;:8081&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="60" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="l7" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#999999;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="110" as="sourcePoint"/><mxPoint x="760" y="600" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v8" value="&lt;b&gt;catalogdb&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="60" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="l9" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#999999;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="110" as="sourcePoint"/><mxPoint x="1030" y="600" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v10" value="&lt;b&gt;orderdb&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="60" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="l11" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#999999;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1270" y="110" as="sourcePoint"/><mxPoint x="1270" y="600" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l12" value="&lt;b&gt;POST /api/orders&lt;/b&gt;" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="150" as="sourcePoint"/><mxPoint x="420" y="150" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v13" value="&lt;b&gt;1&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="116" y="120" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v14" value='&lt;font style="font-size:10px"&gt;&lt;font face="Courier New"&gt;{"bookId":1,"quantity":2,"customerId":"client-42"}&lt;/font&gt;&lt;/font&gt;' style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="100" y="158" width="340" height="20" as="geometry"/></mxCell>
        <mxCell id="l15" value="&lt;b&gt;GET /api/books/1&lt;/b&gt;  (RestClient → app.catalog.url)" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="215" as="sourcePoint"/><mxPoint x="760" y="215" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v16" value="&lt;b&gt;2&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="426" y="185" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="l17" value="SELECT … FROM book WHERE id = 1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="265" as="sourcePoint"/><mxPoint x="1030" y="265" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v18" value="&lt;b&gt;3&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="766" y="235" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="l19" value="Clean Code · 15.00" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="300" as="sourcePoint"/><mxPoint x="760" y="300" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l20" value='200 &lt;font face="Courier New"&gt;{"id":1, …, "price":15.00}&lt;/font&gt;' style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="345" as="sourcePoint"/><mxPoint x="420" y="345" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v21" value="&lt;b&gt;4&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="426" y="315" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v22" value='&lt;b&gt;5&lt;/b&gt;  &lt;font face="Courier New"&gt;order.confirm(price)&lt;/font&gt;&lt;br&gt;totalAmount = price × quantity = 15.00 × 2 = &lt;b&gt;30.00&lt;/b&gt;&lt;br&gt;status = &lt;b&gt;CONFIRMED&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f9f1;strokeColor=#82b366;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="435" y="375" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="l23" value="INSERT INTO orders (…, status, total_amount)" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="470" as="sourcePoint"/><mxPoint x="1270" y="470" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v24" value="&lt;b&gt;6&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="426" y="440" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="l25" value="id = 1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1270" y="500" as="sourcePoint"/><mxPoint x="420" y="500" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l26" value="&lt;b&gt;201 Created&lt;/b&gt; · Location: /api/orders/1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="550" as="sourcePoint"/><mxPoint x="110" y="550" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v27" value="&lt;b&gt;7&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="116" y="520" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v28" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;i&gt;Tout se passe pendant que le client attend : la commande n'existe que si le catalogue a répondu.&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="432" y="555" width="260" height="40" as="geometry"/></mxCell>
        <mxCell id="v29" value="Quand le catalogue ne répond pas comme prévu" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fdf5f5;strokeColor=#b85450;fontColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="1360" height="170" as="geometry"/></mxCell>
        <mxCell id="v30" value='&lt;b&gt;bookId inconnu&lt;/b&gt;&lt;br&gt;catalog-service répond &lt;b&gt;404&lt;/b&gt; → CatalogClient renvoie Optional.empty()&lt;br&gt;→ UnknownBookException → order-service répond &lt;b&gt;&lt;font color="#b85450"&gt;422 Unprocessable Entity&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;i&gt;Erreur métier : réessayer ne sert à rien.&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="655" width="430" height="95" as="geometry"/></mxCell>
        <mxCell id="v31" value='&lt;b&gt;catalog-service arrêté&lt;/b&gt;&lt;br&gt;connexion refusée → &lt;font face="Courier New"&gt;ResourceAccessException&lt;/font&gt;&lt;br&gt;→ order-service répond &lt;b&gt;&lt;font color="#b85450"&gt;503 Service Unavailable&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Couplage temporel&lt;/b&gt; : order-service marche, mais ne peut rien vendre.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="490" y="655" width="430" height="95" as="geometry"/></mxCell>
        <mxCell id="v32" value="&lt;b&gt;Ce que les TP suivants vont changer&lt;/b&gt;&lt;br&gt;• &lt;b&gt;TP3&lt;/b&gt; : nom logique + plusieurs instances (Eureka)&lt;br&gt;• &lt;b&gt;TP6&lt;/b&gt; : retry, time limiter, circuit breaker&lt;br&gt;• &lt;b&gt;TP10&lt;/b&gt; : saga asynchrone via Kafka (plus d'attente du catalogue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="940" y="655" width="420" height="95" as="geometry"/></mxCell>
        <mxCell id="v33" value="&lt;b&gt;Pourquoi passer par l'API ?&lt;/b&gt; order-service a besoin du prix, mais la table book appartient au catalogue (une base par service) : il le demande par HTTP, jamais par SQL." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="758" width="1320" height="25" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. Twelve-factor" id="p2">
