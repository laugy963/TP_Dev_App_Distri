        <mxCell id="l45" value='&lt;b&gt;200&lt;/b&gt;  &lt;font face="Courier New"&gt;{"books":[…1 livre], "recentOrders":[]}&lt;/font&gt;' style="edgeStyle=none;rounded=0;html=1;strokeColor=#2d7d2d;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;fontColor=#2d7d2d;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="645" as="sourcePoint"/><mxPoint x="90" y="645" as="targetPoint"/></mxGeometry></mxCell>
