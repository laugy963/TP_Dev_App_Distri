        <mxCell id="v47" value="Mesuré : order-service arrêté à 11:39:40, appels toutes les 3 s" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fdf8f8;strokeColor=#b85450;fontColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="1360" height="165" as="geometry"/></mxCell>
        <mxCell id="v48" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;/bff/home&lt;/font&gt; via la gateway&lt;/b&gt;&lt;br&gt;t+0 s → t+36 s : &lt;b&gt;&lt;font color=&quot;#2d7d2d&quot;&gt;HTTP 200&lt;/font&gt;&lt;/b&gt; à chaque appel&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;{&quot;livres&quot;:1,&quot;commandes&quot;:0}&lt;/font&gt;&lt;br&gt;&lt;br&gt;Les livres sont toujours là : &lt;b&gt;la page d'accueil reste utilisable&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="715" width="640" height="115" as="geometry"/></mxCell>
        <mxCell id="v49" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;/api/orders&lt;/font&gt; via la gateway (pour comparaison)&lt;/b&gt;&lt;br&gt;de t+0 s à t+72 s environ : &lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;500&lt;/font&gt;&lt;/b&gt; — la gateway envoie encore vers l'instance arrêtée&lt;br&gt;(caches successifs : client Eureka 30 s, puis Spring Cloud LoadBalancer 35 s)&lt;br&gt;à t+74 s : &lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;503 Service Unavailable&lt;/font&gt;&lt;/b&gt; — plus aucune instance connue&lt;br&gt;&lt;br&gt;La gateway aiguille, elle n'a &lt;b&gt;pas de mode dégradé&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="715" width="660" height="115" as="geometry"/></mxCell>
        <mxCell id="v50" value="&lt;b&gt;Légende&lt;/b&gt; — ✗ : service arrêté · trait pointillé : réponse · vert : réponse renvoyée au client. order-service relancé : tout revient en moins d'une minute (52 s)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="1360" height="40" as="geometry"/></mxCell>
