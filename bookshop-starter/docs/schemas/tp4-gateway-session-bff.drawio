<mxfile host="app.diagrams.net">
  <diagram name="1. Architecture gateway + BFF" id="p0">
    <mxGraphModel dx="1400" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v1" value="&lt;b&gt;TP4 — API Gateway, session Redis et BFF&lt;/b&gt; : une seule porte d'entrée (8080) devant tous les services" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="35" as="geometry"/></mxCell>
        <mxCell id="v2" value='&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;navigateur · curl&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;ne connaît que &lt;b&gt;:8080&lt;/b&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="170" height="100" as="geometry"/></mxCell>
        <mxCell id="v3" value='&lt;b&gt;gateway&lt;/b&gt; :8080&lt;br&gt;&lt;font style="font-size:11px"&gt;Spring Cloud Gateway · WebFlux · &lt;b&gt;Netty&lt;/b&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;verticalAlign=top;arcSize=4;" vertex="1" parent="1"><mxGeometry x="240" y="150" width="380" height="410" as="geometry"/></mxCell>
        <mxCell id="v4" value='&lt;b&gt;route catalog&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;&lt;font face="Courier New"&gt;Path=/api/books/**,/api/welcome&lt;/font&gt;&lt;/font&gt; &lt;font style="font-size:10px"&gt;&lt;font face="Courier New"&gt;→ lb://catalog-service&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="260" y="205" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="v5" value='&lt;b&gt;route orders&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;&lt;font face="Courier New"&gt;Path=/api/orders/**&lt;/font&gt;&lt;/font&gt; &lt;font style="font-size:10px"&gt;&lt;font face="Courier New"&gt;→ lb://order-service&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="260" y="275" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="v6" value='&lt;b&gt;route bff&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;&lt;font face="Courier New"&gt;Path=/bff/**&lt;/font&gt;&lt;/font&gt; &lt;font style="font-size:10px"&gt;&lt;font face="Courier New"&gt;→ lb://bff-web&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="260" y="345" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="v7" value='&lt;b&gt;traité par la gateway elle-même&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;&lt;font face="Courier New"&gt;/session/info&lt;/font&gt; · &lt;font face="Courier New"&gt;/actuator/gateway/routes&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;strokeColor=#56517e;dashed=1;" vertex="1" parent="1"><mxGeometry x="260" y="420" width="340" height="58" as="geometry"/></mxCell>
        <mxCell id="v8" value="&lt;font style=&quot;font-size:10px&quot;&gt;Une route = « si le chemin correspond à &lt;b&gt;Path&lt;/b&gt;, envoie à &lt;b&gt;uri&lt;/b&gt; ».&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;lb://&lt;/font&gt; = demande l'adresse à l'annuaire et répartis la charge.&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Jamais spring-boot-starter-web ici : MVC et WebFlux ne cohabitent pas.&lt;/font&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="488" width="345" height="65" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v10" value='&lt;b&gt;discovery-server&lt;/b&gt; :8761&lt;br&gt;&lt;font style="font-size:11px"&gt;GATEWAY · BFF-WEB · CATALOG-SERVICE · ORDER-SERVICE : UP (1)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="440" height="75" as="geometry"/></mxCell>
        <mxCell id="e11" value='&lt;font style="font-size:11px"&gt;lb:// : quelles instances ?&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0e8088;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#0e8088;endArrow=block;endFill=1;dashed=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3" target="v10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="525" y="97"/></Array></mxGeometry></mxCell>
        <mxCell id="v12" value='&lt;b&gt;catalog-service&lt;/b&gt; :8081&lt;br&gt;&lt;font style="font-size:11px"&gt;/api/books · /api/welcome&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="170" width="260" height="75" as="geometry"/></mxCell>
        <mxCell id="v13" value='&lt;b&gt;order-service&lt;/b&gt; :8082&lt;br&gt;&lt;font style="font-size:11px"&gt;/api/orders&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="300" width="260" height="75" as="geometry"/></mxCell>
        <mxCell id="v14" value='&lt;b&gt;bff-web&lt;/b&gt; :8090&lt;br&gt;&lt;font style="font-size:11px"&gt;Spring MVC (Tomcat) · &lt;font face="Courier New"&gt;@LoadBalanced&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;font face="Courier New"&gt;GET /bff/home&lt;/font&gt; :&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;5 premiers livres + 3 dernières commandes&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;en &lt;b&gt;un seul appel&lt;/b&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="450" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#56517e;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v4" target="v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#56517e;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#56517e;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v6" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b46504;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.35;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v14" target="v13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1191" y="485"/></Array></mxGeometry></mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b46504;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v14" target="v12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1385" y="536"/><mxPoint x="1385" y="207"/></Array></mxGeometry></mxCell>
        <mxCell id="v20" value='&lt;font style="font-size:10px"&gt;&lt;font face="Courier New"&gt;http://order-service/api/orders&lt;/font&gt;&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#b46504;" vertex="1" parent="1"><mxGeometry x="1028" y="487" width="240" height="18" as="geometry"/></mxCell>
        <mxCell id="v21" value='&lt;font style="font-size:10px"&gt;&lt;font face="Courier New"&gt;http://catalog-service/api/books&lt;/font&gt;&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#b46504;" vertex="1" parent="1"><mxGeometry x="1028" y="538" width="240" height="18" as="geometry"/></mxCell>
        <mxCell id="v22" value='&lt;font style="font-size:10px"&gt;&lt;i&gt;relaie sans transformer&lt;/i&gt;&lt;/font&gt;' style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#56517e;" vertex="1" parent="1"><mxGeometry x="640" y="395" width="140" height="40" as="geometry"/></mxCell>
        <mxCell id="v23" value='&lt;b&gt;Redis 7&lt;/b&gt; :6379 — &lt;font face="Courier New"&gt;bookshop-redis&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;sessions de la gateway : &lt;font face="Courier New"&gt;spring:session:sessions:&amp;lt;id&amp;gt;&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="610" width="380" height="75" as="geometry"/></mxCell>
        <mxCell id="e24" value='&lt;font style="font-size:11px"&gt;Spring Session (spring-session-data-redis)&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#b85450;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3" target="v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v25" value="&lt;b&gt;Mesuré via la gateway (étape 2)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;curl :8080/actuator/gateway/routes | jq '.[].route_id'&lt;/font&gt; → catalog, orders, bff&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;curl :8080/api/books | jq length&lt;/font&gt; → 1, comme &lt;font face=&quot;Courier New&quot;&gt;:8081&lt;/font&gt; : la gateway n'a rien transformé&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;POST :8080/api/orders&lt;/font&gt; → &lt;font face=&quot;Courier New&quot;&gt;CONFIRMED&lt;/font&gt; · curl → gateway → order-service → catalog-service" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#ffffff;strokeColor=#56517e;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="700" y="600" width="680" height="90" as="geometry"/></mxCell>
        <mxCell id="v26" value="&lt;b&gt;Une seule porte d'entrée&lt;/b&gt;&lt;br&gt;Le client ne connaît plus 8081, 8082, 8090 : seulement 8080.&lt;br&gt;Ajouter une instance ne concerne pas les clients : l'annuaire et lb://&lt;br&gt;s'en chargent. Sécurité, logs et limites se poseront une seule fois,&lt;br&gt;à l'entrée (TP5, TP6).&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;i&gt;Cloud : Azure API Management, AWS API Gateway, Ingress Kubernetes.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="715" width="440" height="108" as="geometry"/></mxCell>
        <mxCell id="v27" value="&lt;b&gt;Gateway et BFF n'ont pas le même rôle&lt;/b&gt;&lt;br&gt;La &lt;b&gt;gateway&lt;/b&gt; aiguille : elle ne connaît que des chemins.&lt;br&gt;Le &lt;b&gt;BFF&lt;/b&gt; assemble : il connaît l'écran (page d'accueil web)&lt;br&gt;et appelle plusieurs services pour lui. On crée un BFF par type&lt;br&gt;de client (web, mobile)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="480" y="715" width="440" height="108" as="geometry"/></mxCell>
        <mxCell id="v28" value="&lt;b&gt;Écart par rapport à l'énoncé&lt;/b&gt;&lt;br&gt;Spring Cloud Gateway 4.1.5 désactive le endpoint &lt;font face=&quot;Courier New&quot;&gt;gateway&lt;/font&gt; par défaut :&lt;br&gt;l'exposer ne suffit pas, il faut aussi&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;management.endpoint.gateway.enabled: true&lt;/font&gt;&lt;br&gt;Sinon &lt;font face=&quot;Courier New&quot;&gt;/actuator/gateway/routes&lt;/font&gt; renvoie 404." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="940" y="715" width="440" height="108" as="geometry"/></mxCell>
        <mxCell id="v29" value="&lt;b&gt;Légende&lt;/b&gt; — violet : routage de la gateway · orange pointillé : appels du BFF · turquoise : annuaire · rouge : stockage des sessions." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="838" width="1360" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. Session dans Redis" id="p1">
    <mxGraphModel dx="1400" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v1" value="&lt;b&gt;TP4 — Ranger la session dans Redis&lt;/b&gt; : une gateway sans état, donc redémarrable et réplicable" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="35" as="geometry"/></mxCell>
        <mxCell id="v2" value="Session en mémoire de la gateway (sans Redis)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fdf8f8;strokeColor=#b85450;fontColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="660" height="330" as="geometry"/></mxCell>
        <mxCell id="v3" value='&lt;b&gt;gateway — copie A&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;mémoire : session &lt;font face="Courier New"&gt;0fdf…&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;font face="Courier New"&gt;visits = 3&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="240" height="95" as="geometry"/></mxCell>
        <mxCell id="v4" value='&lt;b&gt;gateway — copie B&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;mémoire : &lt;i&gt;vide&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="240" height="95" as="geometry"/></mxCell>
        <mxCell id="v5" value='• Requête suivante envoyée sur la copie B : session inconnue → &lt;b&gt;&lt;font color="#b85450"&gt;visits repart à 1&lt;/font&gt;&lt;/b&gt;.&lt;br&gt;• Redémarrage de la copie A : la mémoire est vidée → &lt;b&gt;&lt;font color="#b85450"&gt;session perdue&lt;/font&gt;&lt;/b&gt;.&lt;br&gt;• Seule parade : « sticky sessions » (toujours renvoyer un client vers la même copie),&lt;br&gt;  qui déséquilibre la charge et ne survit pas à un redémarrage.&lt;br&gt;&lt;br&gt;&lt;b&gt;La gateway a un état : on ne peut ni la répliquer ni la redémarrer librement.&lt;/b&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="600" height="160" as="geometry"/></mxCell>
        <mxCell id="v6" value="Session dans Redis (TP4)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f6fbf4;strokeColor=#82b366;fontColor=#2d7d2d;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="720" y="60" width="660" height="330" as="geometry"/></mxCell>
        <mxCell id="v7" value='&lt;b&gt;gateway — copie A&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;i&gt;aucun état en mémoire&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="v8" value='&lt;b&gt;gateway — copie B&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;i&gt;aucun état en mémoire&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="100" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="v9" value='&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;font face="Courier New"&gt;spring:session:sessions:0fdf…&lt;/font&gt;&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fdf3f3;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="950" y="225" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="e10" value='&lt;font style="font-size:11px"&gt;lit / écrit&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#b85450;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v7" target="v9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="265"/></Array></mxGeometry></mxCell>
        <mxCell id="e11" value='&lt;font style="font-size:11px"&gt;lit / écrit&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#b85450;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1220" y="265"/></Array></mxGeometry></mxCell>
        <mxCell id="v12" value="• N'importe quelle copie retrouve la session à partir du cookie → &lt;b&gt;&lt;font color=&quot;#2d7d2d&quot;&gt;visits continue&lt;/font&gt;&lt;/b&gt;.&lt;br&gt;• Redémarrage d'une copie : rien n'est perdu, la session est hors du processus.&lt;br&gt;&lt;b&gt;La gateway est sans état (facteur VI) : on peut la répliquer et la redémarrer.&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="315" width="600" height="70" as="geometry"/></mxCell>
        <mxCell id="v13" value='Mesuré au TP4 : GET /session/info avec le même cookie (&lt;font face="Courier New"&gt;curl -c jar.txt -b jar.txt&lt;/font&gt;)' style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#333333;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="1360" height="275" as="geometry"/></mxCell>
        <mxCell id="v14" value='&lt;b&gt;appel 1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;visits: 1&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="455" width="195" height="78" as="geometry"/></mxCell>
        <mxCell id="v15" value='&lt;b&gt;appel 2&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;visits: 2&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="267" y="455" width="195" height="78" as="geometry"/></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="v14" target="v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v17" value='&lt;b&gt;appel 3&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;visits: 3&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=12;" vertex="1" parent="1"><mxGeometry x="489" y="455" width="195" height="78" as="geometry"/></mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="v15" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v19" value='&lt;b&gt;REDÉMARRAGE&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Ctrl+C puis java -jar&lt;br&gt;PID 29843 → 31529&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="711" y="455" width="195" height="78" as="geometry"/></mxCell>
        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="v17" target="v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v21" value='&lt;b&gt;appel 4&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;visits: &lt;b&gt;4&lt;/b&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="933" y="455" width="195" height="78" as="geometry"/></mxCell>
        <mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="v19" target="v21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v23" value='&lt;b&gt;sans cookie&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;nouvel id 141c…&lt;br&gt;visits: 1&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1155" y="455" width="195" height="78" as="geometry"/></mxCell>
        <mxCell id="v24" value='&lt;font style="font-size:11px"&gt;sessionId &lt;font face="Courier New"&gt;0fdf4d4c-4fb0-4529-988d-613ad388a80e&lt;/font&gt; identique pour les appels 1 à 4&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="540" width="860" height="20" as="geometry"/></mxCell>
        <mxCell id="v25" value='&lt;b&gt;Dans Redis : un hash par session&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;docker exec bookshop-redis redis-cli --scan --pattern "spring:session:*"&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;spring:session:sessions:0fdf4d4c-4fb0-4529-988d-613ad388a80e&lt;/font&gt;&lt;br&gt;champs : &lt;font face="Courier New"&gt;creationTime&lt;/font&gt; · &lt;font face="Courier New"&gt;lastAccessedTime&lt;/font&gt; · &lt;font face="Courier New"&gt;maxInactiveInterval&lt;/font&gt; (1800 s = 30 min)&lt;br&gt;· &lt;b&gt;&lt;font face="Courier New"&gt;sessionAttr:visits&lt;/font&gt;&lt;/b&gt; ← le compteur du SessionInfoController' style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="45" y="570" width="640" height="100" as="geometry"/></mxCell>
        <mxCell id="v26" value="&lt;b&gt;Côté client : un simple cookie&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;SESSION=0fdf4d4c-4fb0-4529-988d-613ad388a80e&lt;/font&gt; (HttpOnly)&lt;br&gt;Le cookie ne contient que l'&lt;b&gt;identifiant&lt;/b&gt; ; les données restent côté serveur, dans Redis.&lt;br&gt;Sans le cookie (contre-essai), la gateway crée une nouvelle session.&lt;br&gt;Rien à coder : la dépendance &lt;font face=&quot;Courier New&quot;&gt;spring-session-data-redis&lt;/font&gt; suffit." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="705" y="570" width="650" height="100" as="geometry"/></mxCell>
        <mxCell id="v27" value='&lt;b&gt;Légende&lt;/b&gt; — violet : gateway · rouge : Redis / redémarrage · vert : appel après redémarrage. &lt;font style="font-size:11px"&gt;&lt;i&gt;Cloud : Azure Cache for Redis, Amazon ElastiCache.&lt;/i&gt;&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="1360" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
