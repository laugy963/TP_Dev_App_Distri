<mxfile host="app.diagrams.net">
  <diagram name="1. Architecture Config Server + Bus" id="p0">
    <mxGraphModel dx="1400" dy="810" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="810" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v1" value="&lt;b&gt;TP2 — Configuration centralisée&lt;/b&gt; : un config-server pour toutes les instances, un bus Kafka pour les recharger à chaud" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="35" as="geometry"/></mxCell>
        <mxCell id="v2" value="config-repo/  (dossier à la racine)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffaf2;strokeColor=#d79b00;fontColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="360" as="geometry"/></mxCell>
        <mxCell id="v3" value='&lt;b&gt;catalog-service.yml&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;i&gt;propre au catalogue&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;app.welcome-message:&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;  "Bienvenue (config server)"&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="260" height="85" as="geometry"/></mxCell>
        <mxCell id="v4" value='&lt;b&gt;application.yml&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;i&gt;commun à tous les services&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;app.shared-message:&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;  "Configuration commune…"&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="260" height="85" as="geometry"/></mxCell>
        <mxCell id="v5" value='Le nom du fichier = le &lt;font face="Courier New"&gt;spring.application.name&lt;/font&gt; du service.&lt;br&gt;En entreprise : un &lt;b&gt;dépôt Git&lt;/b&gt; (profil git) au lieu du profil native : la configuration est versionnée comme du code.' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="315" width="270" height="95" as="geometry"/></mxCell>
        <mxCell id="v6" value='&lt;b&gt;config-server&lt;/b&gt; :8888&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;font face="Courier New"&gt;@EnableConfigServer&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;profil &lt;b&gt;native&lt;/b&gt; : lit des fichiers&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;font face="Courier New"&gt;search-locations: file:./config-repo/&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;→ à lancer depuis la racine du projet&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;endpoints : health, &lt;b&gt;busrefresh&lt;/b&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="150" width="250" height="170" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="v4" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v9" value='&lt;font style="font-size:10px"&gt;&lt;i&gt;relit à chaque requête&lt;/i&gt;&lt;/font&gt;' style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="310" y="120" width="120" height="30" as="geometry"/></mxCell>
        <mxCell id="v10" value='&lt;b&gt;catalog-service&lt;/b&gt; — instance 1 :8081&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;font face="Courier New"&gt;spring.config.import:&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;font face="Courier New"&gt;"optional:configserver:&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;http://localhost:8888"&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;WelcomeController &lt;font face="Courier New"&gt;@RefreshScope&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="90" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="v11" value='&lt;b&gt;catalog-service&lt;/b&gt; — instance 2 :8091&lt;br&gt;&lt;font style="font-size:11px"&gt;même jar, &lt;font face="Courier New"&gt;--server.port=8091&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;même configuration&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;WelcomeController &lt;font face="Courier New"&gt;@RefreshScope&lt;/font&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="260" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=open;startFill=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="v10" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v13" value='&lt;b&gt;GET /catalog-service/default&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;au démarrage, puis à chaque refresh&lt;/font&gt;' style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="200" width="165" height="55" as="geometry"/></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;startArrow=open;startFill=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="v11" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="v15" value="&lt;b&gt;Réponse de /catalog-service/default&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;{&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&quot;name&quot;: &quot;catalog-service&quot;,&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&quot;profiles&quot;: [&quot;default&quot;],&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&quot;propertySources&quot;: [&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;{ &quot;name&quot;: &quot;…/catalog-service.yml&quot;,&lt;/font&gt;  &lt;font color=&quot;#2d7d2d&quot;&gt;&lt;b&gt;① prioritaire&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;source&quot;: {&quot;app.welcome-message&quot;: …} },&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;{ &quot;name&quot;: &quot;…/application.yml&quot;,&lt;/font&gt;  &lt;font color=&quot;#777777&quot;&gt;②&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;source&quot;: {&quot;app.shared-message&quot;: …} }&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;]&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Le fichier du service est listé &lt;b&gt;en premier&lt;/b&gt; : il l'emporte sur&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;le fichier commun pour une même clé.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1070" y="70" width="310" height="255" as="geometry"/></mxCell>
        <mxCell id="v16" value="&lt;b&gt;Kafka&lt;/b&gt; — localhost:9092" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;arcSize=4;" vertex="1" parent="1"><mxGeometry x="370" y="470" width="700" height="120" as="geometry"/></mxCell>
        <mxCell id="v17" value='&lt;b&gt;topic springCloudBus&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Spring Cloud Bus (starter bus-kafka)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="505" width="320" height="60" as="geometry"/></mxCell>
        <mxCell id="e18" value='&lt;b&gt;publie&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&lt;font face="Courier New"&gt;RefreshRemoteApplicationEvent&lt;/font&gt;&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v6" target="v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e19" value='&lt;b&gt;consomme&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;(abonné)&lt;/font&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.4;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v16" target="v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.97;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v16" target="v10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1049" y="140"/></Array></mxGeometry></mxCell>
        <mxCell id="v21" value="&lt;font style=&quot;font-size:10px&quot;&gt;Chaque instance qui a traité l'ordre publie un&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;AckRemoteApplicationEvent&lt;/font&gt; (accusé de réception).&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1075" y="400" width="305" height="60" as="geometry"/></mxCell>
        <mxCell id="v22" value='&lt;b&gt;Vous (administrateur)&lt;/b&gt;&lt;br&gt;1. modifier catalog-service.yml&lt;br&gt;2. &lt;font face="Courier New"&gt;curl -X POST&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;localhost:8888/actuator/busrefresh&lt;/font&gt;&lt;br&gt;→ &lt;b&gt;204&lt;/b&gt; (un seul appel)' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="v22" target="v6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="506"/><mxPoint x="345" y="303"/></Array></mxGeometry></mxCell>
        <mxCell id="v24" value='&lt;b&gt;&lt;font face="Courier New"&gt;optional:&lt;/font&gt; — disponibilité ou cohérence ?&lt;/b&gt;&lt;br&gt;Config-server injoignable au démarrage :&lt;br&gt;• &lt;b&gt;avec&lt;/b&gt; optional: → le catalogue démarre avec son fichier interne&lt;br&gt;  (« Bienvenue (fichier interne) ») : on privilégie la &lt;b&gt;disponibilité&lt;/b&gt;.&lt;br&gt;• &lt;b&gt;sans&lt;/b&gt; optional: → il refuse de démarrer : on privilégie&lt;br&gt;  la &lt;b&gt;cohérence&lt;/b&gt; de la configuration.' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="440" height="125" as="geometry"/></mxCell>
        <mxCell id="v25" value='&lt;b&gt;&lt;font face="Courier New"&gt;@RefreshScope&lt;/font&gt; — ce qui est rechargé&lt;/b&gt;&lt;br&gt;Sans lui, &lt;font face="Courier New"&gt;@Value&lt;/font&gt; est lu une seule fois, au démarrage.&lt;br&gt;Avec lui, Spring &lt;b&gt;recrée le bean&lt;/b&gt; après chaque ordre de rechargement&lt;br&gt;et relit donc la nouvelle valeur.&lt;br&gt;Preuve dans les logs : &lt;font face="Courier New"&gt;Keys refreshed [app.welcome-message]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="480" y="620" width="440" height="125" as="geometry"/></mxCell>
        <mxCell id="v26" value="&lt;b&gt;Pourquoi centraliser ?&lt;/b&gt;&lt;br&gt;Avec 10 services × N instances, modifier un paramètre service par service&lt;br&gt;(recompiler, redéployer) n'est plus tenable.&lt;br&gt;Ici : &lt;b&gt;un fichier modifié, un appel&lt;/b&gt;, toutes les instances à jour,&lt;br&gt;sans redémarrage ni coupure de service.&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;i&gt;Équivalents cloud : Azure App Configuration, AWS AppConfig.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="940" y="620" width="440" height="125" as="geometry"/></mxCell>
        <mxCell id="v27" value="&lt;b&gt;Légende&lt;/b&gt; — orange : configuration (fichiers et config-server) · violet : Kafka / bus · flèches à double sens : requête HTTP et sa réponse." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="1360" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. Rechargement à chaud" id="p1">
    <mxGraphModel dx="1400" dy="985" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="985" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v1" value="&lt;b&gt;TP2 — Rechargement à chaud avec Spring Cloud Bus&lt;/b&gt; : de la modification du fichier à la v2 sur les deux instances" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="35" as="geometry"/></mxCell>
        <mxCell id="v2" value='&lt;b&gt;Vous&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;éditeur + curl&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="15" y="60" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="l3" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#999999;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="110" as="sourcePoint"/><mxPoint x="100" y="790" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v4" value='&lt;b&gt;config-repo/&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;catalog-service.yml&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="60" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="l5" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#999999;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="110" as="sourcePoint"/><mxPoint x="300" y="790" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v6" value='&lt;b&gt;config-server&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;:8888&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="435" y="60" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="l7" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#999999;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="110" as="sourcePoint"/><mxPoint x="520" y="790" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v8" value='&lt;b&gt;Kafka&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;topic springCloudBus&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="675" y="60" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="l9" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#999999;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="110" as="sourcePoint"/><mxPoint x="760" y="790" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v10" value='&lt;b&gt;catalog-service&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;instance 1 :8081&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="925" y="60" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="l11" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#999999;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="110" as="sourcePoint"/><mxPoint x="1010" y="790" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v12" value='&lt;b&gt;catalog-service&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;instance 2 :8091&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1165" y="60" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="l13" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#999999;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="110" as="sourcePoint"/><mxPoint x="1250" y="790" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v14" value="État initial : les deux instances renvoient « Bienvenue (config server) »" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f6fc;strokeColor=#6c8ebf;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="930" y="125" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="l15" value="&lt;b&gt;édite&lt;/b&gt;" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="195" as="sourcePoint"/><mxPoint x="300" y="195" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v16" value="&lt;b&gt;1&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="106" y="165" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v17" value='&lt;font style="font-size:10px"&gt;&lt;font face="Courier New"&gt;"Bienvenue (config server v2)"&lt;/font&gt;&lt;/font&gt;' style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="202" width="260" height="20" as="geometry"/></mxCell>
        <mxCell id="v18" value="Le config-server relit le fichier à chaque requête : il voit déjà la v2.&lt;br&gt;&lt;b&gt;Les instances, elles, gardent la v1 en mémoire.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="410" y="215" width="390" height="50" as="geometry"/></mxCell>
        <mxCell id="l19" value="&lt;b&gt;POST /actuator/busrefresh&lt;/b&gt;" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="310" as="sourcePoint"/><mxPoint x="520" y="310" as="targetPoint"/></mxGeometry></mxCell>
