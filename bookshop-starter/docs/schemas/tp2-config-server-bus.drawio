        <mxCell id="l24" value="livre l'événement" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="440" as="sourcePoint"/><mxPoint x="1010" y="440" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v25" value="&lt;b&gt;4&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="766" y="410" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="l26" value="livre l'événement" style="edgeStyle=none;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="470" as="sourcePoint"/><mxPoint x="1250" y="470" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l27" value="&lt;b&gt;GET /catalog-service/default&lt;/b&gt;  (relit sa configuration)" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="525" as="sourcePoint"/><mxPoint x="520" y="525" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v28" value="&lt;b&gt;5&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="526" y="495" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="l29" value="GET /catalog-service/default" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="555" as="sourcePoint"/><mxPoint x="520" y="555" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l30" value="v2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="585" as="sourcePoint"/><mxPoint x="1010" y="585" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l31" value="v2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="610" as="sourcePoint"/><mxPoint x="1250" y="610" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v32" value='&lt;b&gt;6&lt;/b&gt;  clé modifiée détectée → bean &lt;font face="Courier New"&gt;@RefreshScope&lt;/font&gt; recréé&lt;br&gt;&lt;font face="Courier New"&gt;Keys refreshed [app.welcome-message]&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;(dans la console de chaque instance)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f6fc;strokeColor=#6c8ebf;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="970" y="630" width="340" height="62" as="geometry"/></mxCell>
        <mxCell id="l33" value='&lt;font face="Courier New"&gt;AckRemoteApplicationEvent&lt;/font&gt;' style="edgeStyle=none;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="715" as="sourcePoint"/><mxPoint x="760" y="715" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v34" value="&lt;b&gt;7&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="766" y="685" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="l35" value='&lt;font face="Courier New"&gt;AckRemoteApplicationEvent&lt;/font&gt;' style="edgeStyle=none;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="740" as="sourcePoint"/><mxPoint x="760" y="740" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l36" value='&lt;b&gt;GET /api/welcome&lt;/b&gt; (8081 puis 8091) → &lt;font color="#2d7d2d"&gt;&lt;b&gt;« Bienvenue (config server v2) »&lt;/b&gt;&lt;/font&gt;' style="edgeStyle=none;rounded=0;html=1;strokeColor=#333333;strokeWidth=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="775" as="sourcePoint"/><mxPoint x="1250" y="775" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="v37" value="&lt;b&gt;8&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="106" y="745" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="v38" value="&lt;b&gt;Aucun service n'a été redémarré.&lt;/b&gt; Un seul appel a mis à jour deux instances ; avec 50 instances, ce serait toujours un seul appel." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="805" width="1360" height="25" as="geometry"/></mxCell>
        <mxCell id="v39" value="Deux vérifications de robustesse (étape 7)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="840" width="1360" height="125" as="geometry"/></mxCell>
        <mxCell id="v40" value="&lt;b&gt;7.1 — Config-server arrêté, instance 1 relancée&lt;/b&gt;&lt;br&gt;→ démarre quand même (avertissement) et répond « Bienvenue (fichier interne) » grâce à &lt;font face=&quot;Courier New&quot;&gt;optional:&lt;/font&gt;.&lt;br&gt;Le service reste &lt;b&gt;disponible&lt;/b&gt;, au prix d'une configuration qui n'est plus la configuration centrale." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="872" width="650" height="80" as="geometry"/></mxCell>
        <mxCell id="v41" value="&lt;b&gt;7.2 — L'argument de lancement reste le plus fort&lt;/b&gt;&lt;br&gt;Instance 2 relancée avec &lt;font face=&quot;Courier New&quot;&gt;--app.welcome-message=&quot;Bienvenue (ligne de commande)&quot;&lt;/font&gt;, puis v3 + busrefresh :&lt;br&gt;8081 → « config server v3 » · 8091 → « ligne de commande ».&lt;br&gt;Précédence : argument &gt; variable d'env. &gt; &lt;b&gt;config-server&lt;/b&gt; &gt; fichier interne &gt; défaut du code." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=4;" vertex="1" parent="1"><mxGeometry x="710" y="872" width="650" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
